<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>VitalWatch</RootNamespace>
    <AssemblyName>VitalWatch.AspNetCore</AssemblyName>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <!--
      Sürüm tek yerde. CI'daki yayın adımı v* etiketini bu değerle karşılaştırır;
      `sdk_version` da derlenmiş derlemenin bilgi sürümünden okunur. "+sha" eki
      kapalı: hub alanı 32 karakterle kırpıyor ve panel sürümü olduğu gibi gösteriyor.
    -->
    <Version>0.1.1</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>

    <PackageId>VitalWatch.AspNetCore</PackageId>
    <Authors>CestnyTR</Authors>
    <Description>ASP.NET Core reporter for VitalWatch Hub — unhandled exceptions, 5xx responses, slow requests, slow SQL queries (EF Core, SqlClient, Npgsql) and crashed background services. No runtime dependencies.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/CestnyTR/vitalwatch-dotnet</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/CestnyTR/vitalwatch-dotnet</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>monitoring;error-tracking;aspnetcore;efcore;vitalwatch</PackageTags>
  </PropertyGroup>

  <!--
    Tek bağımlılık paylaşılan çerçeve. EF Core, SqlClient ya da Npgsql paketine
    BAĞIMLILIK YOK: sorgular DiagnosticListener / ActivitySource üzerinden,
    yük nesnesinin özellikleri adla okunarak dinleniyor.
  -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <InternalsVisibleTo Include="VitalWatch.AspNetCore.Tests" />
  </ItemGroup>

</Project>
